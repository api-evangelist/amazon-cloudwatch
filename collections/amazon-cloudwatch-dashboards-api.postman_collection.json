          "name": "Amazon CloudWatch List dashboards",
          "request": {
            "name": "Amazon CloudWatch List dashboards",
            "description": {
              "content": "Returns a list of the dashboards for your account. If you include DashboardNamePrefix, only those dashboards with names starting with the prefix are listed. Otherwise, all dashboards in your account are listed.",
