          "name": "Amazon CloudWatch Create or update a dashboard",
          "request": {
            "name": "Amazon CloudWatch Create or update a dashboard",
            "description": {
              "content": "Creates a dashboard if it does not already exist, or updates an existing dashboard. If you update a dashboard, the entire contents are replaced with what you specify here. There is no limit to the number of dashboards in your account.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "Action",
                  "value": "PutDashboard"
                },
                {
                  "disabled": false,
                  "key": "DashboardName",
                  "value": "<string>",
                  "description": "(Required) The name of the dashboard"
                },
                {
                  "disabled": false,
                  "key": "DashboardBody",
                  "value": "<string>",
                  "description": "(Required) The detailed information about the dashboard in JSON format, including the widgets to include and their location on the dashboard"
                }
